# Firmendaten für Gashini Dienstleistungen
# ---------------------------------------
# Hier die echten Daten eintragen und anschließend  bash scripts/firmendaten.sh  ausführen.
# Das Skript erzeugt den fertigen Auftritt im Ordner dist/ – die Vorlagen bleiben unverändert.

INHABER="Vor- und Nachname des Inhabers"
STRASSE="Straße und Hausnummer"
PLZ="00000"
ORT="Ort"
PLZ_ORT="00000 Ort"
EINSATZGEBIET="Ort und Umkreis 50 km"

TELEFON="+49 000 0000000"
TELEFON_LINK="+490000000000"          # ohne Leerzeichen, für tel:-Links
WHATSAPP="490000000000"               # internationales Format ohne + und ohne Leerzeichen
EMAIL="info@example.de"
DOMAIN="www.example.de"

# --- MyHammer ---
MYHAMMER_URL="https://www.my-hammer.de/profil/HIER-EIGENES-PROFIL-EINTRAGEN"
MYHAMMER_NOTE="4,9"                   # Durchschnittsnote laut Profil
MYHAMMER_BEWERTUNGEN="00"             # Anzahl der Bewertungen laut Profil

# --- Rechtliches (Impressum, Briefbogen, Signatur) ---
USTID="DE000000000"
STEUERNUMMER="000/000/00000"
HANDWERKSROLLE="z. B. Handwerksrolle der HWK Musterstadt, Nr. 000000 – oder streichen"
KAMMER="z. B. Handwerkskammer / IHK Musterstadt"
BERUFSBEZEICHNUNG="z. B. Gebäudereiniger"
VERSICHERUNG_NAME="Name der Versicherung"
VERSICHERUNG_ANSCHRIFT="Anschrift der Versicherung"
VERSICHERUNG_GELTUNGSBEREICH="Deutschland"
AUFSICHTSBEHOERDE="zuständige Landesdatenschutzbehörde eintragen"
HOSTER="Name des Hosting-Anbieters"
LOG_SPEICHERDAUER="spätestens 7 Tagen"
STAND_DATUM="Monat Jahr"
BANK="Name der Bank"
IBAN="DE00 0000 0000 0000 0000 00"
BIC="XXXXDE00XXX"

# --- Formular ---
FORMULAR_ENDPOINT="https://formular-dienst.example/ID"   # z. B. Formspree/Formcarry-Endpunkt oder eigenes PHP-Skript

# --- Referenzen (nur echte, freigegebene Kundenstimmen eintragen!) ---
