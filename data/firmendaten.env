# ============================================================================
# Firmendaten – öffentlich
# ----------------------------------------------------------------------------
# Diese Datei liegt im Repository und ist damit für jeden lesbar.
# Hier nur Angaben eintragen, die ohnehin auf der Website stehen.
# Bankverbindung, Steuernummer o. Ä. gehören in data/firmendaten.privat.env
# (nicht im Repository, Vorlage: data/firmendaten.privat.beispiel.env).
#
# Werte in [eckigen Klammern] gelten als NICHT BESTÄTIGT. Die Vorschau zeigt
# sie sichtbar an; der Produktions-Build bricht ab, solange einer übrig ist.
# Leere optionale Werte entfernen den zugehörigen Abschnitt von der Website.
# ============================================================================

# --- Betrieb ---
INHABER="[Name des Inhabers]"
INHABER_TEXT="[Zwei, drei Sätze zum Inhaber: Werdegang, seit wann selbstständig, was ihm bei der Arbeit wichtig ist.]"
STRASSE="[Straße und Hausnummer]"
PLZ="[PLZ]"
ORT="[Ort]"
PLZ_ORT="[PLZ Ort]"
REGION="[Region]"
EINSATZGEBIET="[Ort und Umkreis, z. B. Musterstadt und 30 km Umkreis]"

# --- Kontakt ---
TELEFON="[Telefonnummer]"
TELEFON_LINK="[+490000000000]"          # nur Ziffern und +, für tel:-Links
TELEFONZEITEN="[Telefonzeiten]"
EMAIL="[E-Mail-Adresse]"
DOMAIN="[ihre-domain.de]"               # ohne https://, z. B. www.gashini.de
WHATSAPP=""                             # optional, internationales Format ohne + (leer = kein WhatsApp-Kontakt)

# --- Profile (optional, leer = Link wird nicht angezeigt) ---
MYHAMMER_URL=""
GOOGLE_PROFIL_URL=""

# --- Impressum (optional, leer = Abschnitt entfällt) ---
USTID=""
HANDWERKSROLLE=""
KAMMER=""
VERSICHERUNG_NAME=""
VERSICHERUNG_ANSCHRIFT=""
VERSICHERUNG_GELTUNGSBEREICH="Deutschland"
VERSICHERUNG_ANTWORT="[FREIGABE ERFORDERLICH: Besteht eine Betriebshaftpflichtversicherung? Antworttext für die FAQ.]"
BILDNACHWEIS="Visualisierungen und technische Zeichnungen sind eigene Darstellungen von Gashini Dienstleistungen; sie zeigen vereinfachte Beispielaufbauten und keine ausgeführten Aufträge. Fotos stammen von Gashini Dienstleistungen, sofern nicht anders angegeben."

# --- Datenschutz ---
HOSTER="[Name und Anschrift des Hosting-Anbieters]"
LOG_SPEICHERDAUER="[Speicherdauer der Server-Protokolle laut Hoster, z. B. 7 Tagen]"
MAILVERSAND="[Versandweg, z. B. über das Postfach beim Hoster]"
ANFRAGE_SPEICHERDAUER="[Frist, z. B. sechs Monaten nach dem letzten Kontakt]"
DRITTLAND_HINWEIS="[FREIGABE ERFORDERLICH: Verarbeiten Hoster und E-Mail-Anbieter ausschließlich in der EU? Wenn ja: Eine Übermittlung in Länder außerhalb der EU findet nicht statt.]"
AUFSICHTSBEHOERDE="[zuständige Landesdatenschutzbehörde]"
STAND_DATUM="[Monat Jahr]"
STAND_ISO="2026-10-10"                  # für die Sitemap, Format JJJJ-MM-TT
