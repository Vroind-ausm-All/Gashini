# Gashini Dienstleistungen – Apache-Konfiguration
# Quelle: src/server/htaccess · wird als web/.htaccess ausgegeben.
# Nur gültig, wenn der Webspace Apache verwendet. Für nginx siehe docs/DEPLOYMENT.md.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Alte Vorschau-Adressen (vor dem Relaunch) – gezielte Weiterleitungen, nicht pauschal zur Startseite
  RewriteRule ^wohnungsuebergabe\.html$   /leistungen/hausmeisterservice/#mieterwechsel [R=301,NE,L]
  RewriteRule ^haushaltsaufloesung\.html$ /leistungen/ [R=301,L]
  RewriteRule ^preise\.html$              /fragen/#kosten [R=301,NE,L]
  RewriteRule ^referenzen\.html$          /projekte/ [R=301,L]
  RewriteRule ^leistungen\.html$          /leistungen/ [R=301,L]
  RewriteRule ^ablauf\.html$              /fragen/ [R=301,L]
  RewriteRule ^ablauf/?$                  /fragen/ [R=301,L]
  RewriteRule ^ueber-uns\.html$           /ueber-uns/ [R=301,L]
  RewriteRule ^kontakt\.html$             /kontakt/ [R=301,L]
  RewriteRule ^danke\.html$               /kontakt/danke/ [R=301,L]
  RewriteRule ^impressum\.html$           /impressum/ [R=301,L]
  RewriteRule ^datenschutz\.html$         /datenschutz/ [R=301,L]
</IfModule>

# Keine versteckten Dateien und keine Projektdateien ausliefern
<FilesMatch "(^\.|\.(md|env|json|log|sh|py|bak|dist|example)$)">
  Require all denied
</FilesMatch>
<Files "sitemap.xml">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  # HSTS bewusst ohne includeSubDomains und ohne preload – erst ergänzen, wenn alle Subdomains HTTPS sprechen
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>

# Kurzclips (src/assets/videos): richtige Medientypen, auch wenn der Server .webm noch nicht kennt
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
